<script>
(function(){
  "use strict";
  var DT = (function(){
  "use strict";
  var MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  var DAYS = ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"];
  function fdiv(a,b){ return Math.floor(a/b); }
  function fmod(a,b){ return a - Math.floor(a/b)*b; }
  function isLeap(y){ return (y%4===0 && y%100!==0) || y%400===0; }
  function lenMonth(y,m){ return [31, isLeap(y)?29:28, 31,30,31,30,31,31,30,31,30,31][m-1]; }
  function toEpoch(y,m,d){
    y -= (m<=2) ? 1 : 0;
    var era = fdiv(y,400), yoe = y - era*400;
    var doy = fdiv(153*(m + (m>2 ? -3 : 9)) + 2, 5) + d - 1;
    var doe = yoe*365 + fdiv(yoe,4) - fdiv(yoe,100) + doy;
    return era*146097 + doe - 719468;
  }
  function fromEpoch(z){
    z += 719468;
    var era = fdiv(z,146097), doe = z - era*146097;
    var yoe = fdiv(doe - fdiv(doe,1460) + fdiv(doe,36524) - fdiv(doe,146096), 365);
    var y = yoe + era*400;
    var doy = doe - (365*yoe + fdiv(yoe,4) - fdiv(yoe,100));
    var mp = fdiv(5*doy+2,153);
    var d = doy - fdiv(153*mp+2,5) + 1;
    var m = mp<10 ? mp+3 : mp-9;
    return {y: y + (m<=2 ? 1 : 0), m: m, d: d};
  }
  function pad(n,w){ var s = String(Math.abs(n)); while(s.length<w) s = "0"+s; return (n<0?"-":"")+s; }
  function iso(o){ return pad(o.y,4)+"-"+pad(o.m,2)+"-"+pad(o.d,2); }
  function of(y,m,d){
    if(m<1||m>12) return {ok:false, msg:"Invalid value for MonthOfYear (valid values 1 - 12): "+m};
    if(d<1||d>31) return {ok:false, msg:"Invalid value for DayOfMonth (valid values 1 - 28/31): "+d};
    if(d>lenMonth(y,m)){
      if(d===29) return {ok:false, msg:"Invalid date 'February 29' as '"+y+"' is not a leap year"};
      return {ok:false, msg:"Invalid date '"+MONTHS[m-1].toUpperCase()+" "+d+"'"};
    }
    return {ok:true, v:{y:y,m:m,d:d}};
  }
  function plusDays(o,n){ return fromEpoch(toEpoch(o.y,o.m,o.d)+n); }
  function plusMonths(o,n){
    var total = o.y*12 + (o.m-1) + n;
    var ny = fdiv(total,12), nm = fmod(total,12)+1;
    return {y:ny, m:nm, d:Math.min(o.d, lenMonth(ny,nm))};
  }
  function plusYears(o,n){ var ny=o.y+n; return {y:ny, m:o.m, d:Math.min(o.d, lenMonth(ny,o.m))}; }
  function dow(o){ return fmod(toEpoch(o.y,o.m,o.d)+3,7)+1; }
  function period(a,b){
    var total = (b.y*12+b.m-1) - (a.y*12+a.m-1);
    var days = b.d - a.d;
    if(total>0 && days<0){
      total--;
      var calc = plusMonths(a,total);
      days = toEpoch(b.y,b.m,b.d) - toEpoch(calc.y,calc.m,calc.d);
    } else if(total<0 && days>0){
      total++;
      days -= lenMonth(b.y,b.m);
    }
    var years = Math.trunc(total/12), months = total % 12;
    return {years:years===0?0:years, months:months===0?0:months, days:days===0?0:days};
  }
  function fmt(dt, pattern){
    var out = "", i = 0, bad = [], parts = [];
    var h12 = dt.H%12===0 ? 12 : dt.H%12;
    while(i<pattern.length){
      var c = pattern[i];
      if(c==="'"){
        var j = pattern.indexOf("'", i+1);
        if(j===-1){ return {error:"IllegalArgumentException: Pattern ends with an incomplete string literal"}; }
        var lit = (j===i+1) ? "'" : pattern.slice(i+1,j); out += lit; parts.push({src:pattern.slice(i,j+1), val:lit, lit:true});
        i = j+1; continue;
      }
      if(/[A-Za-z]/.test(c)){
        var k = i; while(k<pattern.length && pattern[k]===c) k++;
        var run = pattern.slice(i,k), n = run.length, t = null;
        if(c==="y" && n===4) t = pad(dt.y,4);
        else if(c==="y" && n===2) t = pad(fmod(dt.y,100),2);
        else if(c==="M" && n===4) t = MONTHS[dt.m-1];
        else if(c==="M" && n===3) t = MONTHS[dt.m-1].slice(0,3);
        else if(c==="M" && n===2) t = pad(dt.m,2);
        else if(c==="M" && n===1) t = String(dt.m);
        else if(c==="d" && n===2) t = pad(dt.d,2);
        else if(c==="d" && n===1) t = String(dt.d);
        else if(c==="a" && n===1) t = dt.H<12 ? "AM" : "PM";
        else if(c==="H" && n===2) t = pad(dt.H,2);
        else if(c==="H" && n===1) t = String(dt.H);
        else if(c==="h" && n===2) t = pad(h12,2);
        else if(c==="h" && n===1) t = String(h12);
        else if(c==="m" && n===2) t = pad(dt.mi,2);
        else if(c==="m" && n===1) t = String(dt.mi);
        else if(c==="s" && n===2) t = pad(dt.s,2);
        else if(c==="s" && n===1) t = String(dt.s);
        if(t===null){ bad.push(run); out += run; parts.push({src:run, val:null}); } else { out += t; parts.push({src:run, val:t}); }
        i = k; continue;
      }
      out += c; parts.push({src:c, val:c, lit:true}); i++;
    }
    return {text: out, unsupported: bad, parts: parts};
  }
  function seconds(h1,m1,s1,h2,m2,s2){ return (h2*3600+m2*60+s2)-(h1*3600+m1*60+s1); }
  return {MONTHS:MONTHS, DAYS:DAYS, isLeap:isLeap, lenMonth:lenMonth, toEpoch:toEpoch, fromEpoch:fromEpoch, pad:pad, iso:iso, of:of,
          plusDays:plusDays, plusMonths:plusMonths, plusYears:plusYears, dow:dow, period:period, fmt:fmt, seconds:seconds};
})();



  function highlight(code){
    const KEYWORDS = new Set(['void','int','double','boolean','new','return','if','else','for','while','class','public','static','private','protected','this','extends','try','catch','finally','throw','throws','import']);
    const TYPES = new Set(['String','System','out','args','LocalDate','LocalTime','LocalDateTime','DateTimeFormatter','Period','Duration','DateTimeException']);
    const escaped = code.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    const pattern = /("(?:[^"\\]|\\.)*")|(\/\/[^\n]*)|\b([A-Za-z_]\w*)\b(?=\s*\()|\b([A-Za-z_]\w*)\b/g;
    return escaped.replace(pattern, (match, str, comment, fnCall, word) => {
      if(str !== undefined) return `<span class="tok-str">${str}</span>`;
      if(comment !== undefined) return `<span class="tok-com">${comment}</span>`;
      if(fnCall !== undefined){
        if(KEYWORDS.has(fnCall)) return `<span class="tok-kw">${fnCall}</span>`;
        return `<span class="tok-fn">${fnCall}</span>`;
      }
      if(word !== undefined){
        if(KEYWORDS.has(word)) return `<span class="tok-kw">${word}</span>`;
        if(TYPES.has(word)) return `<span class="tok-type">${word}</span>`;
        return word;
      }
      return match;
    });
  }
  document.querySelectorAll('.codeblock pre code').forEach(el=>{ el.innerHTML = highlight(el.textContent); });
